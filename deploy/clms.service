[Unit]
Description=CLMS Essay Archive
After=network-online.target

[Service]
Type=simple
User=clms
Group=clms
WorkingDirectory=/opt/clms
EnvironmentFile=/etc/clms/archive.env
ExecStartPre=/opt/clms/.venv/bin/python -m backend.app.cli init
ExecStartPre=/opt/clms/.venv/bin/alembic upgrade head
ExecStart=/opt/clms/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8472 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clms-archive

[Install]
WantedBy=multi-user.target
