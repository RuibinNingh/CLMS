# New essay archive only. Never point this at an old CLMS vault.
CLMS_DATA_DIR=/var/lib/clms-archive
CLMS_PUBLIC_ORIGIN=https://essays.example.com
CLMS_SECURE_COOKIE=true
# Default media budgets are described in docs/operations/deployment.md.
# No model URL, model API key, OCR provider, or administrator password is used here.
